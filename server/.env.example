# Server
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/canvasflow

# Authentication
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
AUTH_PEPPER=your-secret-pepper-string-change-this-too

# AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# WebRTC
WEBRTC_ENABLED=true
