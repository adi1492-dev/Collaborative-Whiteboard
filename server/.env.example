# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
AUTH_PEPPER=your-secret-pepper-string-change-this-too

# ─── Database (Turso) ─────────────────────────────────────────────────────────
# Get these from: https://turso.tech → your database → Connect
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ─── AI (Gemini) ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ─── File Uploads ─────────────────────────────────────────────────────────────
# LOCAL DEV: leave CLOUDINARY_URL empty → saves to ./uploads folder
# PRODUCTION: set CLOUDINARY_URL → uploads to Cloudinary CDN (no local disk needed)
# Get from: https://cloudinary.com → Dashboard → API Environment variable
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ─── WebRTC ───────────────────────────────────────────────────────────────────
WEBRTC_ENABLED=true

# ─── CORS (Production) ────────────────────────────────────────────────────────
# Set this to your Vercel frontend URL on Railway (no trailing slash)
# Example: https://collaborative-whiteboard.vercel.app
FRONTEND_URL=https://your-app.vercel.app
